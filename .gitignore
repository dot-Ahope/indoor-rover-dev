# === 펌웨어 빌드 산출물 ===
firmware/**/build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.su

# === STM32CubeMX ===
firmware/**/.mxproject
# 주의: rover_jupiter_fw.ioc 는 커밋 대상 (제외하지 않음)

# === ROS2 workspace (Jetson, 추후) ===
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# === micro-ROS ===
# upstream utility (clone, 재현 가능 — 트래킹 안 함)
firmware/**/micro_ros_stm32cubemx_utils/
# 생성된 라이브러리 (~수MB, scripts/build_libmicroros_wsl.sh 로 재생성)
firmware/**/libmicroros/

# === IDE / 에디터 ===
.vscode/
.idea/
*.swp
*~

# === OS ===
.DS_Store
Thumbs.db

# === 초보자 가이드 (로컬 전용, GitHub 미포함) ===
Docs_Beginner/

# === Python 유틸 ===
__pycache__/
*.pyc

# === 연구 노트 ===
research_notes/

# rosbag 기록 — 사후 검토용. 용량이 커서(주행 1회당 10~15MB) 저장소에 넣지 않는다.
# 로컬 경로: Docs/debug_log/<날짜>/bags/  — Foxglove Studio 의 'Open local file' 로 연다.
# 특정 주행을 근거로 보존해야 하면 그때 의도적으로 강제 추가(git add -f)한다.
Docs/debug_log/*/bags/
# 주행 영상(mp4, 수십 MB) — 로컬 보관, git 제외(2026-09-30). 만드는 스크립트는 jobs/ 에 있음.
Docs/debug_log/*/videos/
