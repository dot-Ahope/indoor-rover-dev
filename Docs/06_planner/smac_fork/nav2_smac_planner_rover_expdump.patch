+struct ExpansionDump
+{
+  bool on{std::getenv("SMAC_EXP_DIR") != nullptr};
+  std::vector<std::array<float, 5>> rows;
+  ~ExpansionDump()
+  {
+    if (!on) {return;}
+    static int n = 0;
+    std::ofstream f(std::string(std::getenv("SMAC_EXP_DIR")) + "/exp_" + std::to_string(n++) + ".txt");
+    for (const auto & r : rows) {f << r[0] << ' ' << r[1] << ' ' << r[2] << ' ' << r[3] << ' ' << r[4] << '\n';}
+  }
+};
+}  // namespace
