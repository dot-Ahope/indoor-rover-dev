<?xml version="1.0"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.1.0</version>
  <description>Jupiter rover 통합 bringup (micro-ros-agent + description; 이후 EKF/LiDAR 추가)</description>
  <maintainer email="alopsrobotics.share@gmail.com">ALOPS</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 2026-09-28: sensor_conditioner C++ 이식 -->
  <depend>rclcpp</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <exec_depend>rover_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
