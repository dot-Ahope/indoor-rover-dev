<?xml version="1.0" ?>
<!-- Jupiter rover URDF (xacro) — 확정본 rover.urdf 와 같은 TF 트리 · 같은 값 + 데크 인자화 · 데크 메시 시각화.
     2026-10-30 재작성: 이전 판(08-27 초안)은 WT-600 개정 전 값(데크 x 0 · 카메라 dx 0.0822 · 트랙 y ±0.095 ·
     base_z 0.025 · sensor_deck_link 없음)이 남아 있어 use_xacro:=true 로 띄우면 라이다 · 카메라가 x 로 약 15 cm 어긋났다
     (Docs/issues/sensor-deck-yaw.md). 값의 근거는 rover.urdf 주석 — 여기서는 그 값을 기본으로 쓴다.
     좌표: ROS(X전방/Y좌/Z상). base_footprint = 지면, base_link = +0.02567(휠 유효 구름 반경).
     인자(기본 = rover.urdf 확정값; 데크를 다시 조립하면 재측정 — CLAUDE.md 하드웨어 요약 ⚠):
       deck_x, deck_y : 데크 원점(라이다 마운트 중심, 판 하면) 의 base_link 기준 위치 [m]
       deck_z         : 같은 원점의 높이 [m] (= 판 하면 지면高 0.185 − 0.02567)
       deck_yaw       : 데크 장착 yaw [rad] (2026-09-18 실측 −2.68°)
       lidar_yaw      : 데크 기준 라이다 yaw [rad] (π — RPLidar 하드웨어 0° = 로버 후방, 2026-08-28) -->
<robot name="jupiter_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="deck_x"    default="0.152"/>
  <xacro:arg name="deck_y"    default="0.0"/>
  <xacro:arg name="deck_z"    default="0.159"/>
  <xacro:arg name="deck_yaw"  default="-0.04677"/>
  <xacro:arg name="lidar_yaw" default="3.14159265"/>

  <xacro:property name="base_z"   value="0.02567"/>
  <xacro:property name="deck_x"   value="$(arg deck_x)"/>
  <xacro:property name="deck_y"   value="$(arg deck_y)"/>
  <xacro:property name="deck_z"   value="$(arg deck_z)"/>
  <xacro:property name="deck_yaw" value="$(arg deck_yaw)"/>
  <!-- 데크 원점 기준 센서 오프셋 (rover.urdf 확정값: 라이다 z 0.185 − 0.159, 카메라 (0.080, 0.0475, 0.143 − 0.159)) -->
  <xacro:property name="lidar_dz" value="0.026"/>
  <xacro:property name="cam_dx"   value="0.080"/>
  <xacro:property name="cam_dy"   value="0.0475"/>
  <xacro:property name="cam_dz"   value="-0.016"/>

  <material name="green"><color rgba="0.1 0.7 0.3 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="petg"><color rgba="0.16 0.17 0.18 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- 차체: WT-600 본체 (트랙 제외 폭 0.25) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <geometry><box size="0.50 0.25 0.105"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <geometry><box size="0.50 0.25 0.105"/></geometry>
    </collision>
    <inertial>
      <mass value="8.5"/>
      <origin xyz="0 0 0.027" rpy="0 0 0"/>
      <inertia ixx="0.0521" ixy="0.0" ixz="0.0" iyy="0.1849" iyz="0.0" izz="0.2214"/>
    </inertial>
  </link>

  <xacro:macro name="track" params="side y">
    <link name="${side}_track">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.50 0.04 0.105"/></geometry><material name="black"/></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.50 0.04 0.105"/></geometry></collision>
      <inertial>
        <mass value="0.6"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00063" ixy="0.0" ixz="0.0" iyy="0.01305" iyz="0.0" izz="0.01258"/>
      </inertial>
    </link>
    <joint name="${side}_track_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_track"/>
      <origin xyz="0 ${y} 0.027" rpy="0 0 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:track side="left"  y="0.1225"/>
  <xacro:track side="right" y="-0.1225"/>

  <!-- 보드 IMU (ICM-20948, 상판 3.5° 기울기 상속) — 자이로 무반응으로 미융합, TF 만 유지 -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.09" rpy="0 -0.0611 0"/>
  </joint>

  <!-- 센서 데크: 원점 = 라이다 마운트 중심 · 판 하면. 시각화 = FUSED_ROVER 메시(mm → m, 같은 원점) -->
  <link name="sensor_deck_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://rover_description/meshes/sensor_deck.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="petg"/>
    </visual>
  </link>
  <joint name="sensor_deck_joint" type="fixed">
    <parent link="base_link"/><child link="sensor_deck_link"/>
    <origin xyz="${deck_x} ${deck_y} ${deck_z}" rpy="0 0 ${deck_yaw}"/>
  </joint>

  <!-- 라이다 RPLidar S2L — lidar_link 원점 = 스캔면 중심. 방향 = 라이다 yaw + 데크 yaw (stuck_monitor.py LIDAR_YAW 와 한 쌍) -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0385" length="0.0398"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="${deck_x} ${deck_y} ${deck_z + lidar_dz}" rpy="0 0 ${$(arg lidar_yaw) + deck_yaw}"/>
  </joint>

  <!-- 카메라 RealSense D455f — camera_link = 좌IR이미저. 위치 = 데크 원점 + 데크 yaw 로 돌린 (cam_dx, cam_dy) -->
  <link name="camera_link">
    <visual>
      <origin xyz="-0.003 -0.0475 0" rpy="0 0 0"/>
      <geometry><box size="0.026 0.124 0.029"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="${deck_x + cam_dx*cos(deck_yaw) - cam_dy*sin(deck_yaw)} ${deck_y + cam_dx*sin(deck_yaw) + cam_dy*cos(deck_yaw)} ${deck_z + cam_dz}" rpy="0 0 ${deck_yaw}"/>
  </joint>

</robot>
